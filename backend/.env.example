ENVIRONMENT=local

HOST=0.0.0.0
PORT=8000

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
OCR_MODEL=mistral-ocr-latest
STT_MODEL=voxtral-mini-latest
STT_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
STT_STREAMING_DELAY_MS=250
STT_REFINE_AFTER_STOP=true

CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_SIZE_MB=100
OCR_TIMEOUT_SECONDS=30
SPEECH_TIMEOUT_SECONDS=60
OCR_BATCH_PAGES=20
OCR_MAX_PAGES=1500
OCR_SECONDS_PER_PAGE=15
OCR_BATCH_TIMEOUT_FLOOR_SECONDS=60

RATE_LIMIT_REQUESTS_PER_MINUTE=10

# RAG
RAG_EMBEDDING_MODEL=mistral-embed
RAG_CHAT_MODEL=mistral-small-latest
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_EMBEDDING_TIMEOUT_SECONDS=120
RAG_CHAT_TIMEOUT_SECONDS=90
RAG_INDEX_DIR=data/rag
MISTRAL_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
EMBEDDING_MAX_CONCURRENCY=2
OCR_MAX_CONCURRENCY=4
MISTRAL_RETRY_BASE_SECONDS=1.0

# UP Forest application persistence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/up_forest
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=local

# Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion
STORAGE_BACKEND=local
STORAGE_ROOT=data/documents
INGESTION_MAX_CONCURRENCY=1
INGESTION_JOB_TIMEOUT_SECONDS=7200
VECTOR_STORE=pgvector

# RAG / Tutor
RAG_DENSE_TOP_K=10
RAG_BM25_TOP_K=10
RAG_FUSED_TOP_K=8
RAG_CONTEXT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_RERANKER_ENABLED=false
RAG_MAX_CONTEXT_CHARS=20000
TUTOR_MAX_HISTORY_MESSAGES=10

# Progress Intelligence
MASTERY_QUIZ_WEIGHT=0.50
MASTERY_COMPLETION_WEIGHT=0.25
MASTERY_RECENCY_WEIGHT=0.15
MASTERY_ACTIVITY_WEIGHT=0.10
QUIZ_LATEST_WEIGHT=0.50
QUIZ_AVERAGE_WEIGHT=0.30
QUIZ_BEST_WEIGHT=0.20
MASTERY_WEAK_THRESHOLD=40
MASTERY_REVIEW_THRESHOLD=60
MASTERY_MASTERED_THRESHOLD=80
MIN_EVIDENCE_FOR_MASTERED=2
RECENCY_DECAY_DAYS=30
REVIEW_INTERVAL_VERY_WEAK_DAYS=1
REVIEW_INTERVAL_WEAK_DAYS=3
REVIEW_INTERVAL_DEVELOPING_DAYS=7
REVIEW_INTERVAL_GOOD_DAYS=14
REVIEW_INTERVAL_MASTERED_DAYS=30
REVIEW_PRIORITY_WEAKNESS_WEIGHT=0.40
REVIEW_PRIORITY_RECENCY_WEIGHT=0.25
REVIEW_PRIORITY_DECLINE_WEIGHT=0.20
REVIEW_PRIORITY_COVERAGE_WEIGHT=0.15
PROGRESS_CACHE_TTL_SECONDS=300
ACTIVITY_POINTS_PER_EVENT=10
ACTIVITY_SIGNAL_CAP=50
DECLINE_POINTS_MULTIPLIER=2

# Instructor/Admin intelligence
LEARNING_RISK_MASTERY_WEIGHT=0.30
LEARNING_RISK_COVERAGE_WEIGHT=0.20
LEARNING_RISK_DECLINE_WEIGHT=0.20
LEARNING_RISK_INACTIVITY_WEIGHT=0.15
LEARNING_RISK_OVERDUE_WEIGHT=0.15
LEARNING_RISK_HIGH_THRESHOLD=60
LEARNING_RISK_MEDIUM_THRESHOLD=35
RISK_INACTIVITY_WARNING_DAYS=7
RISK_INACTIVITY_HIGH_DAYS=30
RISK_OVERDUE_SATURATION_COUNT=5
ANALYTICS_CACHE_TTL_SECONDS=300
QUIZ_QUESTION_MIN_EVIDENCE=3

# Password reset / SMTP
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
